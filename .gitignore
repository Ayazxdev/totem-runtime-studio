# Rust / Cargo build artifacts

/target/
/target_bench/

# Per-crate target directories (if any crate is built standalone)
crates/*/target/

# Cargo lock for libraries (keep for binaries — this is a binary workspace)
# Cargo.lock is intentionally TRACKED for reproducible builds of the sentinel binary.
# Do not add Cargo.lock here.

